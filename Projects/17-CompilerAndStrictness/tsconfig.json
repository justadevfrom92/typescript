{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // The base config already turns on "strict", "noUncheckedIndexedAccess",
    // "noImplicitOverride" and "noFallthroughCasesInSwitch". This lesson adds the rest:
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false
  },
  "include": ["src", "../Types"]
}
